# 生产环境配置（vite build 时加载）

VITE_APP_TITLE=TaskHub

# 生产环境由 Nginx 等反向代理把 /api 转发到后端，因此保持同域相对路径
VITE_API_BASE_URL=/api/v1

# 生产环境不存在 Vite 代理，该变量仅用于本地 preview 调试
VITE_PROXY_TARGET=http://localhost:8080

# 生产环境默认关闭 Swagger 跳转入口
VITE_SWAGGER_URL=

# 构建产物是否包含 sourcemap，排查线上问题时可临时改为 true
VITE_BUILD_SOURCEMAP=false
